{
  "name": "maud-ui",
  "version": "0.1.0",
  "type": "module",
  "description": "MaudUI - Accessible component library built with Rust/Maud and vanilla JS behaviors",
  "scripts": {
    "build": "node js/build.mjs",
    "build:watch": "node --watch js/build.mjs",
    "build:static": "bun run js/export-static.mjs",
    "build:og": "bun run js/build-og.mjs",
    "start": "bun server.ts",
    "gallery": "./scripts/gallery.sh",
    "gallery:stop": "./scripts/gallery.sh --stop",
    "test:js": "bun run js/runtime-test.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.21.0"
  }
}
